# TrustedChain Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit your actual .env file.

# ─── Required: Admin Credentials ─────────────────────────────────────────────
# Set strong values before deploying.
TRUSTCHAIN_ADMIN_USER=admin
TRUSTCHAIN_ADMIN_PASS=changeme

# ─── Optional: API Token ──────────────────────────────────────────────────────
# Token-based auth alternative to Basic Auth for the ML prediction API.
TRUSTCHAIN_API_TOKEN=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4173
HOST=0.0.0.0

# ─── Model Options ────────────────────────────────────────────────────────────
# Use the lightweight fast model (recommended for CPU servers).
TRUSTCHAIN_USE_FAST_MODEL=true

# Delegate inference to a remote prediction server (e.g. GPU server via Tailscale).
# Leave empty to run inference locally.
TRUSTCHAIN_REMOTE_PREDICT_URL=

# ─── GitHub Model Release Download (optional) ─────────────────────────────────
# If model files are hosted as GitHub Release assets, set these to auto-download.
TRUSTCHAIN_MODEL_RELEASE_REPO=
TRUSTCHAIN_MODEL_RELEASE_TAG=
GITHUB_TOKEN=
